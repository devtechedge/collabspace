generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Board {
  id        String    @id @default(uuid())
  name      String    @default("Untitled Board")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  elements  Element[]
  messages  Message[]
}

model Element {
  id          String   @id @default(uuid())
  boardId     String
  type        String   // PENCIL, LINE, RECTANGLE, CIRCLE, TEXT, ERASER, STICKY
  x           Float    @default(0)
  y           Float    @default(0)
  width       Float    @default(0)
  height      Float    @default(0)
  points      String   @default("[]") // JSON string for curve points
  color       String   @default("#ffffff")
  fontWeight  String   @default("normal")
  textContent String   @default("")
  createdAt   DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(uuid())
  boardId   String
  userId    String
  username  String
  userColor String   @default("#6366f1")
  text      String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}
